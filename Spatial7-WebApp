<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Studio Assistant</title>
  
  <!-- CSS Styling -->
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    body {
      background-color: #0f172a;
      color: #f8fafc;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }
    .app-card {
      background-color: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      width: 100%;
      max-width: 600px;
      padding: 24px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }
    h1 {
      font-size: 1.5rem;
      margin-bottom: 8px;
      color: #38bdf8;
    }
    p {
      color: #94a3b8;
      font-size: 0.9rem;
      margin-bottom: 20px;
    }
    .input-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }
    input, textarea {
      width: 100%;
      padding: 12px;
      background-color: #0f172a;
      border: 1px solid #475569;
      border-radius: 8px;
      color: #fff;
      font-size: 0.95rem;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: #38bdf8;
    }
    button {
      padding: 12px 20px;
      background-color: #2563eb;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s;
    }
    button:hover {
      background-color: #1d4ed8;
    }
    .output-box {
      background-color: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 16px;
      min-height: 100px;
      white-space: pre-wrap;
      color: #e2e8f0;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>

  <div class="app-card">
    <h1>Google AI Studio Generator</h1>
    <p>Enter your prompt below to send a request to Gemini API.</p>

    <div class="input-group">
      <input type="password" id="apiKeyInput" placeholder="Enter Gemini API Key..." />
      <textarea id="promptInput" rows="4" placeholder="Type your prompt here..."></textarea>
      <button id="generateBtn" onclick="sendAiRequest()">Generate Response</button>
    </div>

    <h3>Output:</h3>
    <div id="outputContainer" class="output-box">Response will appear here...</div>
  </div>

  <!-- JavaScript Logic -->
  <script>
    async function sendAiRequest() {
      const apiKey = document.getElementById('apiKeyInput').value.trim();
      const prompt = document.getElementById('promptInput').value.trim();
      const outputBox = document.getElementById('outputContainer');

      if (!apiKey || !prompt) {
        alert('Please enter both your API Key and a prompt.');
        return;
      }

      outputBox.innerText = 'Generating response...';

      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`;

      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            contents: [{
              parts: [{ text: prompt }]
            }]
          })
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error?.message || `Error ${response.status}`);
        }

        const data = await response.json();
        const responseText = data.candidates[0].content.parts[0].text;
        outputBox.innerText = responseText;

      } catch (error) {
        outputBox.innerText = `Failed to generate: ${error.message}`;
        console.error('API Error:', error);
      }
    }
  </script>

</body>
</html>
